# Copy this file to .env in the project root (it loads automatically) and fill
# in what you need. Never commit .env. Keep comments on their own lines: dotenv
# reads "KEY= # note" as the value "# note".

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
USE_MOCK_ANALYTICS=true

# AI: bedrock = Amazon Nova on AWS; fallback = offline deterministic answers.
AI_PROVIDER=fallback
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# AWS credentials for AI_PROVIDER=bedrock. Use one of:
#   - a Bedrock API key (Bedrock console > API keys): uncomment the next line
#   - the workshop machine's IAM role: nothing to set
#   - a named AWS CLI profile: uncomment AWS_PROFILE
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_PROFILE=shellhacks

# Alpaca paper-account keys for stock and ETF prices. Crypto needs none.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
