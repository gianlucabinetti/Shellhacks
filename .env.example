CORS_ORIGINS=http://localhost:3000,http://localhost:5173
USE_MOCK_ANALYTICS=true

# Copy this file to .env in the project root. It is loaded automatically.
# bedrock = Amazon Nova on AWS; fallback = offline deterministic explanations.
AI_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Prefer the workshop machine's IAM role (no keys needed).
# On your laptop, use the workshop's temporary CLI credentials if offered.
# All three values are required for temporary credentials. Do not commit .env.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Alternatively, use an already configured AWS CLI profile:
# AWS_PROFILE=shellhacks

